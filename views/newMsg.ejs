<html>
  <%- include("components/head", {title: title}) %>
  <body>
    <p>new Msg</p>
    <%- include("components/navbar", {links: links}) %>
    <form class="message-container" method="POST" action="/new">
      <h2>Add a new message</h2>
      <%- include("components/errors.ejs") %>
      <div class="input-container">
        <label for="author">Your name</label>
        <input type="text" name="author" id="author" autofocus maxlength="30" placeholder="Username" required>
      </div>
      <div class="input-container vertical">
        <label for="message">Your Message</label>
        <textarea name="message" id="message" rows="10" required placeholder="Message" maxlength="200"></textarea>
      </div>
      <button type="submit">Send Message</button>
    </form>
  </body>
</html>